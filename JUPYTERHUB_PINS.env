# The JupyterHub version every user-facing image runs alongside the hub.
# POSIX shell assignments only; read by the notebook images (conda
# jupyterhub-singleuser), r-studio and ngshare-notebook (pip jupyterhub),
# their smoke tests, and ci/regen-constraints.sh.
#
# The hub is Z2JH chart 4.4.x / JupyterHub 5.5.4, running the chart's stock
# k8s-hub image (K8S_HUB_IMAGE below).
# conda-forge's 5.5 series ends at 5.5.2 (5.5.3/5.5.4 are PyPI-only), so
# every image uses 5.5.2, which is compatible with a 5.5.x hub. Changing it
# rebuilds every image that COPYs this file; regenerate both constraints
# files afterwards (ci/regen-constraints.sh).
#
# Expected scan finding: ECR flags jupyterhub 5.5.2 in every user image for
# the six advisories fixed in 5.5.3. All six are hub-side (the hub runs
# 5.5.4), and conda-forge has no 5.5.3/5.5.4, so this is accepted until the
# hub-6 chart.
JUPYTERHUB_VERSION=5.5.2

# The chart's stock hub image; its tag is the deployed chart version. Not
# deployed from here (the chart uses its own default); ci/hub-compat.sh runs
# it to learn the hub's JupyterHub version. Update it with every chart
# upgrade, together with JUPYTERHUB_VERSION above. Full ref, so the digest
# pin is kept.
K8S_HUB_IMAGE=quay.io/jupyterhub/k8s-hub:4.4.4@sha256:bbce7a924eac0dfe10d738ff2d966cb306a40973519005a160282415561a774b
