# Reviewed immutable runtime inputs. POSIX shell assignments only.
# Shared by scipy-notebook and r-notebook so pinned versions can't drift
# between the two images.
CLAUDE_CODE_VERSION=2.1.270
GEMINI_CLI_VERSION=0.59.0
CODEX_ACP_VERSION=0.16.0
# Replaces the npm bundled with conda-forge nodejs=22, whose vendored
# sigstore/pacote/picomatch are flagged by scans. npm 12 needs node >=22.22.2.
NPM_VERSION=12.2.1
